# === API KEYS (optional — scrape works with ZERO keys via free engines) ===
# SerpAPI for Google search results (better quality/limits when scaling).
SERPAPI_KEY=
# ScrapingBee for site rendering (JS-heavy pages) + premium proxies.
SCRAPINGBEE_API_KEY=
# Proxy list as comma-separated http://user:pass@host:port
PROXY_LIST=

# === SCRAPER TUNING ===
# Country to target for lead discovery (us, uk, ca, au, de, ...).
SEARCH_COUNTRY=us
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.5
TIMEOUT_SECONDS=20
MAX_CONCURRENT_REQUESTS=4
USER_AGENT_ROTATE=true

# === FREE-LITE OPTIONS (default-on, no payment needed) ===
# Render JS-only pages through the free jina.ai reader proxy to recover
# emails that plain HTTP fetching cannot see (no key required). Rate-limited.
FREE_JS_RENDER=true
# Cache search results to data/cache/ so reruns don't re-hit free engines
# (which are the ones that bot-block). Old results reused for CACHE_SEARCH_HOURS.
CACHE_SEARCH=true
CACHE_SEARCH_HOURS=168
# Pool of public SearXNG instances used as an extra free search fallback.
SEARX_INSTANCES=https://searx.be,https://priv.au,https://search.bus-hit.me,https://searx.tiekoetter.com,https://paulgo.io,https://search.hbubli.cc

# === EMAIL VERIFICATION ===
# When true (default) emails are checked for valid MX records using
# email-validator. Set to 0 to skip verification at scrape time.
VERIFY_EMAILS=true
# Check robots.txt before fetching target pages (including redirects).
RESPECT_ROBOTS=true
# Off by default: generic addresses are guesses even if the domain has MX.
# Exports mark them email_origin=inferred; do not treat them as verified mailboxes.
INFER_EMAILS=false

# === SUPABASE LEAD STORAGE (optional) ===
# When both values are set, each successful CLI run upserts leads into the
# public.leads table. Keep the secret key server-side; never commit it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
